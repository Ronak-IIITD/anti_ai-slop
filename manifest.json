{
  "manifest_version": 3,
  "name": "Anti-Slop - AI & Brainrot Content Blocker",
  "short_name": "Anti-Slop",
  "version": "1.7.0",
  "description": "Block low-quality, addictive content and AI-generated slop across YouTube, Instagram, Twitter, TikTok, Reddit, Google, LinkedIn, Facebook, Bluesky, and news sites. Reclaim your focus.",
  "homepage_url": "https://github.com/Ronak-IIITD/anti_ai-slop",
  "offline_enabled": true,
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.tiktok.com/*",
    "*://*.reddit.com/*",
    "*://*.google.com/*",
    "*://*.google.co.in/*",
    "*://*.linkedin.com/*",
    "*://*.facebook.com/*",
    "*://*.messenger.com/*",
    "*://bsky.app/*",
    "*://*.bsky.app/*",
    "*://threads.net/*",
    "*://*.threads.net/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://*.linkedin.com/*",
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://bsky.app/*",
        "*://*.bsky.app/*",
        "*://threads.net/*",
        "*://*.threads.net/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["content-scripts/bootstrap.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content-scripts/bootstrap.js"],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*",
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://bsky.app/*",
        "*://*.bsky.app/*",
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://threads.net/*",
        "*://*.threads.net/*",
        "*://*.github.com/*",
        "*://*.stackoverflow.com/*",
        "*://*.claude.ai/*",
        "*://*.anthropic.com/*",
        "*://*.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.gemini.google.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://*.perplexity.ai/*",
        "*://*.wikipedia.org/*",
        "*://*.wikimedia.org/*",
        "*://*.amazon.com/*",
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.notion.so/*",
        "*://*.figma.com/*",
        "*://*.linear.app/*",
        "*://*.slack.com/*",
        "*://*.discord.com/*",
        "*://*.arxiv.org/*",
        "*://*.scholar.google.com/*",
        "*://*.netflix.com/*",
        "*://*.spotify.com/*",
        "*://*.gmail.com/*",
        "*://*.mail.google.com/*",
        "*://*.drive.google.com/*",
        "*://*.docs.google.com/*",
        "*://*.maps.google.com/*",
        "*://*.calendar.google.com/*",
        "*://*.whatsapp.com/*",
        "*://*.web.whatsapp.com/*",
        "*://*.leetcode.com/*",
        "*://*.hackerrank.com/*",
        "*://*.codeforces.com/*",
        "*://*.codechef.com/*",
        "*://*.coursera.org/*",
        "*://*.udemy.com/*",
        "*://*.khanacademy.org/*",
        "*://*.edx.org/*",
        "*://*.npmjs.com/*",
        "*://*.pypi.org/*",
        "*://*.developer.mozilla.org/*",
        "*://*.w3schools.com/*",
        "*://*.localhost/*",
        "*://localhost/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle Anti-Slop on/off"
    },
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Anti-Slop popup"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
